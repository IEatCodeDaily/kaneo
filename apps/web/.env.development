# Relative so every API call, auth request and websocket goes to the page's own
# origin and is proxied to the API by Vite (see server.proxy in vite.config.ts).
#
# Worth keeping even over plain HTTP: same-origin requests skip the CORS preflight
# that an absolute http://localhost:1337 URL triggers, and it makes the app work
# unchanged if the dev server is ever served over TLS (an https page may not fetch
# http:// nor open a ws:// socket).
VITE_API_URL=/api
VITE_CLIENT_URL=http://localhost:5173
